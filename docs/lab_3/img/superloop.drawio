<mxfile host="drawio">
  <diagram id="superloop" name="Super loop">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="g1" value="Старт - один раз до циклу (USER CODE 2)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="340" height="700" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b&gt;HAL_Init, SystemClock_Config&lt;/b&gt;&lt;br&gt;48 МГц від HSI; SysTick 1 мс&lt;br&gt;&lt;b&gt;MX_*_Init&lt;/b&gt;: GPIO, ADC1, I2C1, TIM3, USART2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;Вимірювання (PERF=1)&lt;/b&gt;&lt;br&gt;stack painting резерву 1 КБ (0xDEADBEEF),&lt;br&gt;perf_hal_init, рядки &lt;i&gt;BOOT&lt;/i&gt;, &lt;i&gt;KNOBS&lt;/i&gt;, &lt;i&gt;PERF&lt;/i&gt;;&lt;br&gt;серво 90°, калібрування АЦП" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="300" height="72" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;selftest_run - FR-08&lt;/b&gt;&lt;br&gt;MPU-6050: WHO_AM_I = 0x68, вихід зі SLEEP&lt;br&gt;LCD 0x27: ініціалізація HD44780&lt;br&gt;LDR gate і class: код АЦП у межах; серво&lt;br&gt;I²C тут з 1 спробою (повторює драйвер)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="234" width="300" height="86" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;fail &amp;gt; 0 ?&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;shape=rhombus;perimeter=rhombusPerimeter;rounded=0;" vertex="1" parent="1"><mxGeometry x="90" y="342" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;b&gt;FAULT&lt;/b&gt;&lt;br&gt;&lt;i&gt;FAULT reason=...&lt;/i&gt;&lt;br&gt;imu_task вимкнена,&lt;br&gt;на LCD «FAULT:» і причина" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="140" height="92" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;b&gt;READY&lt;/b&gt;&lt;br&gt;&lt;i&gt;STATE state=READY&lt;/i&gt;&lt;br&gt;на 221 мс (сим.),&lt;br&gt;без MPU - 177 мс" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="200" y="440" width="140" height="92" as="geometry"/></mxCell>
        <mxCell id="b8" value="&lt;b&gt;STACK, HEAP&lt;/b&gt; після старту; t_gate = t_imu = t_lcd = HAL_GetTick()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="556" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="t9" value="Консоль і LCD працюють і у FAULT. Стани сортувальника (App/sorter):&lt;br&gt;READY → SORTING (PARCEL_IN) → READY (PARCEL_OUT);&lt;br&gt;READY, SORTING ↔ ESTOP (B1);&lt;br&gt;FAULT - до перезапуску." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="616" width="300" height="96" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e13" value="так" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e14" value="ні" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b5" target="b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g17" value="Super loop - while (1) у main.c (USER CODE 3)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=13;fillColor=#fafafa;strokeColor=#424242;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="720" height="960" as="geometry"/></mxCell>
        <mxCell id="b18" value="&lt;b&gt;perf_load_poll&lt;/b&gt; - раз на 1 с рядок &lt;i&gt;LOAD pct=...&lt;/i&gt; (~7,9 мс друку поза задачами, D6 = 0)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="470" y="60" width="620" height="46" as="geometry"/></mxCell>
        <mxCell id="b19" value="&lt;b&gt;uart_rx_task&lt;/b&gt; · кожен прохід, якщо в RDR є байт · CLI, FR-10&lt;br&gt;uart_hal_getc (опитування RXNE, FIFO немає) → ехо → cli_feed → cmd_run + відповідь&lt;br&gt;&lt;i&gt;символ ~0,09 мс; status 8,1 мс; stats ~185 мс, до 207 мс (сим.)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="128" width="620" height="92" as="geometry"/></mxCell>
        <mxCell id="b20" value="&lt;b&gt;estop_task&lt;/b&gt; · подія від EXTI, рішення через 20 мс антибрязкоту · FR-07&lt;br&gt;PC13 = 0 → sorter_estop_toggle, рядок &lt;i&gt;ESTOP n=..&lt;/i&gt;; PC13 = 1 → брязкіт; EXTI знову ввімкнено&lt;br&gt;&lt;i&gt;~2,9 мс; від натискання 19,1-60,5 мс (6.2.2), до 195,9 мс у S3 (сим.)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="240" width="620" height="92" as="geometry"/></mxCell>
        <mxCell id="b21" value="&lt;b&gt;gate_task&lt;/b&gt; · кожні 5 мс (period_due) · FR-01&lt;br&gt;adc_hal_read(gate) → gate_update, гістерезис 2400 / 1600 → PARCEL_IN: &lt;b&gt;D4↑&lt;/b&gt;, parcel_pending&lt;br&gt;&lt;i&gt;0,115 мс; з рядком PARCEL_IN ~3 мс (сим.)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="352" width="620" height="92" as="geometry"/></mxCell>
        <mxCell id="b22" value="&lt;b&gt;sort_task&lt;/b&gt; · подія PARCEL_IN, у тому ж проході · FR-02, FR-03, FR-05, FR-06&lt;br&gt;adc_hal_read(class) → classify → sorter_parcel_in (лоток, лічильники) → servo CCR → &lt;b&gt;D4↓&lt;/b&gt;&lt;br&gt;потім рядок &lt;i&gt;SORT ... route=.. angle=..&lt;/i&gt; і EVT&lt;br&gt;&lt;i&gt;PARCEL_IN → CCR 3,1 мс; дедлайн FR-03: заслінка ≤ 50 мс після виявлення&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="464" width="620" height="104" as="geometry"/></mxCell>
        <mxCell id="b23" value="&lt;b&gt;imu_task&lt;/b&gt; · кожні 10 мс, якщо MPU пройшов самоперевірку · FR-04, FR-09&lt;br&gt;mpu6050_read_accel_raw (2 транзакції I²C, до 3 спроб кожна) → |a|² &amp;gt; (2 g)² → sorter_impact (удар → брак)&lt;br&gt;&lt;i&gt;1,04 мс; NACK +33,7 мс; SDA на GND - до 95 мс (сим.)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="588" width="620" height="92" as="geometry"/></mxCell>
        <mxCell id="b24" value="&lt;b&gt;lcd_task&lt;/b&gt; · кожні 500 мс · FR-06, FR-08 · &lt;b&gt;D7&lt;/b&gt;&lt;br&gt;стан і лічильники A/B/R (або FAULT): 2 × (курсор + 16 символів) = 136 записів I²C по 1 байту&lt;br&gt;&lt;i&gt;38,2 мс; з NACK 71,6 мс, два NACK - 105,3 мс (сим.)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="700" width="620" height="92" as="geometry"/></mxCell>
        <mxCell id="b25" value="&lt;b&gt;ready_flush&lt;/b&gt; (EVT ready_* при старті) · &lt;b&gt;STAT loop&lt;/b&gt; += perf_now() - t_loop" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="470" y="812" width="620" height="46" as="geometry"/></mxCell>
        <mxCell id="t26" value="Кожна задача сама дивиться на HAL_GetTick і одразу повертається, якщо не її час. Робота обгорнута TASK_RUN: &lt;b&gt;D6↑&lt;/b&gt; (PB13) → perf_begin → робота → perf_end → &lt;b&gt;D6↓&lt;/b&gt;. Пріоритет - лише порядок у циклі. Найгірша затримка PARCEL_IN: T_gate + Σ C_інших + C_gate_in + C_sort_ccr + T_pwm (docs/tasks.md, розділ 3)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="868" width="620" height="104" as="geometry"/></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b18" target="b19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b19" target="b20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b20" target="b21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e30" value="parcel_pending = 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b21" target="b22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b22" target="b23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b23" target="b24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b24" target="b25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e34" value="наступний прохід" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b25" target="b18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="835"/><mxPoint x="440" y="83"/></Array></mxGeometry></mxCell>
        <mxCell id="e35" value="удар" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 4;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="b23" target="b22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1104" y="616"/><mxPoint x="1104" y="537"/></Array></mxGeometry></mxCell>
        <mxCell id="g36" value="Переривання (stm32c0xx_it.c)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=13;fillColor=#fff8f8;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1160" y="20" width="460" height="360" as="geometry"/></mxCell>
        <mxCell id="b37" value="&lt;b&gt;SysTick_Handler&lt;/b&gt; · кожну 1 мс · пріоритет 3&lt;br&gt;HAL_IncTick → &lt;b&gt;uwTick&lt;/b&gt;&lt;br&gt;HAL_GetTick: періоди задач (period_due), антибрязкіт, мітки рядків &amp;lt;мс&amp;gt;&lt;br&gt;perf_now = uwTick · 48 000 + (LOAD - VAL): такти 20,8 нс (DWT на M0+ немає)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1180" y="60" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="b38" value="&lt;b&gt;EXTI4_15_IRQHandler&lt;/b&gt; · спад PC13 (B1) · пріоритет 0&lt;br&gt;HAL_GPIO_EXTI_Falling_Callback: вимкнути свій IRQ (брязкіт до 2,4 мс),&lt;br&gt;estop_irq_cyc = perf_now(), estop_edge_ms, &lt;b&gt;estop_pending = 1&lt;/b&gt;&lt;br&gt;рішення - не тут, а в estop_task" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1180" y="200" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="t39" value="Більше переривань немає: UART RX, I²C, АЦП і друк - опитуванням HAL, з тайм-аутами. Саме це в ЛР3 і міряю (docs/limitations.md)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1180" y="318" width="420" height="56" as="geometry"/></mxCell>
        <mxCell id="e40" value="estop_pending" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 4;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b38" target="b20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="266"/><mxPoint x="1140" y="286"/></Array></mxGeometry></mxCell>
        <mxCell id="e41" value="HAL_GetTick, perf_now" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=2 3;endFill=0;endArrow=open;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b37" target="b18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="96"/><mxPoint x="1130" y="83"/></Array></mxGeometry></mxCell>
        <mxCell id="g42" value="Службові піни → логічний аналізатор" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=13;fillColor=#f6fbf4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1160" y="400" width="460" height="250" as="geometry"/></mxCell>
        <mxCell id="b43" value="&lt;b&gt;D4&lt;/b&gt; · PA5 (LD4) · ↑ PARCEL_IN у gate_task, ↓ CCR записано в sort_task" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1180" y="440" width="420" height="40" as="geometry"/></mxCell>
        <mxCell id="b44" value="&lt;b&gt;D5&lt;/b&gt; · PC13 (B1) · сама кнопка, разом з брязкотом" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1180" y="488" width="420" height="40" as="geometry"/></mxCell>
        <mxCell id="b45" value="&lt;b&gt;D6&lt;/b&gt; · PB13 · 1, поки працює будь-яка задача (TASK_RUN, BSRR)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1180" y="536" width="420" height="40" as="geometry"/></mxCell>
